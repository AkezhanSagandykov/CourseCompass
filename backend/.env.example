# Copy this file to .env and fill in the values. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (matches docker-compose.yml in the project root)
POSTGRES_DB=coursecompass
POSTGRES_USER=coursecompass
POSTGRES_PASSWORD=coursecompass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# React dev server address: used for CORS and for links in verification emails
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only emails from this domain can sign up
ALLOWED_EMAIL_DOMAIN=kbtu.kz

# Email: the console backend prints verification links in the terminal (mock verification for demos).
# For real emails switch to django.core.mail.backends.smtp.EmailBackend and fill the SMTP settings.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CourseCompass <no-reply@coursecompass.local>
